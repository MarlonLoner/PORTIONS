generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  LOST
  VIP
}

enum RiskScore {
  LOW
  MEDIUM
  HIGH
}

enum PackageType {
  STANDARD
  PREMIUM
  FAMILY_PACK
  CORPORATE
  CHRONIC_PLUS
}

enum FollowUpType {
  DUE_TODAY
  OVERDUE
  PRESCRIPTION_RENEWAL_NEEDED
  PAYMENT_PENDING
  DELIVERY_CONFIRMATION
  LOST_PATIENT_REVIVAL
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  DONE
  SNOOZED
  CANCELLED
}

enum FollowUpOutcomeType {
  PATIENT_CONTACTED
  REFILL_CONFIRMED
  DELIVERY_BOOKED
  COLLECTION_CONFIRMED
  PAYMENT_PENDING
  NO_RESPONSE
  CALLBACK_REQUESTED
  PATIENT_LOST
  OTHER
}

enum OrderSource {
  WHATSAPP
  WEBSITE
  APP
  WALK_IN
  DIASPORA
}

enum OrderStatus {
  NEW
  PHARMACIST_REVIEW
  QUOTED
  AWAITING_PAYMENT
  PAID
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderType {
  PRESCRIPTION
  REFILL
  OTC
  FAMILY_PACK
}

enum StockStatus {
  HEALTHY
  LOW_STOCK
  OVERSTOCK
  NEAR_EXPIRY
  DEAD_STOCK
}

enum ReportType {
  DAILY_EXECUTIVE
  WEEKLY_BRANCH
  CHRONIC_RETENTION
  ONLINE_SALES
  STOCK_RISK
  STAFF_FOLLOW_UP
  EVENT_PERFORMANCE
}

enum PilotRequestStatus {
  NEW
  REVIEWED
  CONTACTED
  QUALIFIED
  CLOSED
}

enum ImportBatchStatus {
  DRAFT
  NEEDS_CLEANUP
  READY
  APPROVED
  IMPORTED
}

enum OperationalActionCategory {
  CHRONIC_PATIENT
  ORDER_RECOVERY
  STOCK_INTERVENTION
  BRANCH_ISSUE
  PILOT_TASK
  MANAGEMENT_DECISION
  GENERAL
}

enum OperationalActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperationalActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum OperationalActionOutcome {
  REVENUE_RECOVERED
  REVENUE_PROTECTED
  PATIENT_CONTACTED
  ORDER_RESOLVED
  STOCK_RESOLVED
  BRANCH_ESCALATED
  NO_RESPONSE
  NO_VALUE
  OTHER
}

enum NotificationType {
  ACTION_DUE
  ACTION_OVERDUE
  ACTION_BLOCKED
  ACTION_UNASSIGNED
  CRITICAL_ACTION
  ORDER_PAYMENT_RISK
  CHRONIC_REFILL_RISK
  STOCK_RISK
  BRANCH_ESCALATION
  PILOT_REVIEW
  EVENT_APPROVAL_REQUIRED
  EVENT_FUNDING_REQUIRED
  EVENT_CHECKLIST_DUE
  EVENT_CHECKLIST_OVERDUE
  EVENT_CHECKLIST_BLOCKED
  EVENT_READINESS_RISK
  EVENT_STARTING_SOON
  EVENT_REVIEW_DUE
  EVENT_BUDGET_RISK
  EVENT_OWNER_UNASSIGNED
  MANAGEMENT_ALERT
  GENERAL
}

enum NotificationSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum NotificationRecipientType {
  STAFF
  BRANCH_MANAGER
  MANAGEMENT
  OWNER
  ROLE
  GENERAL
}

enum NotificationDeliveryChannel {
  IN_APP
  EMAIL_READY
  WHATSAPP_READY
  SMS_READY
}

enum NotificationDeliveryStatus {
  NOT_REQUIRED
  PENDING
  READY
  SENT
  FAILED
}

enum CommunicationChannel {
  WHATSAPP
  PHONE_CALL
  SMS_READY
  EMAIL_READY
  IN_APP
  OTHER
}

enum CommunicationStatus {
  DRAFT
  READY
  OPENED
  SENT
  FAILED
  RESPONDED
  COMPLETED
  CANCELLED
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationRecipientType {
  PATIENT
  CUSTOMER
  STAFF
  BRANCH_MANAGER
  SUPPLIER
  COMPANY
  EVENT_PARTNER
  OTHER
}

enum CommunicationOutcomeType {
  NO_RESPONSE
  RESPONSE_RECEIVED
  REFILL_CONFIRMED
  DELIVERY_CONFIRMED
  COLLECTION_CONFIRMED
  PAYMENT_PROMISED
  PAYMENT_RECEIVED
  EVENT_ATTENDANCE_CONFIRMED
  LEAD_CAPTURED
  ISSUE_RESOLVED
  CALLBACK_REQUIRED
  OTHER
}

enum OperatingUnitType {
  PHYSICAL_BRANCH
  ONLINE_DEPARTMENT
  CALL_CENTRE
  HEAD_OFFICE
  CENTRAL_WAREHOUSE
  MARKETING
  FINANCE
  ADMINISTRATION
  OTHER
}

enum OperatingUnitStatus {
  ACTIVE
  INACTIVE
  SETUP
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  OWNER
  CEO
  GENERAL_MANAGER
  BRANCH_MANAGER
  PHARMACIST
  SUPPORT_AGENT
  ONLINE_ORDERS_AGENT
  STOCK_CONTROLLER
  MARKETING_COORDINATOR
  EVENT_COORDINATOR
  FINANCE_ADMIN
  SYSTEM_ADMIN
  VIEW_ONLY
}

enum OperatingUnitAccessLevel {
  VIEW
  OPERATE
  MANAGE
  APPROVE
  ADMIN
}

enum EventType {
  HEALTH_OUTREACH
  CORPORATE_ACTIVATION
  CONFERENCE
  EXHIBITION
  BRANCH_PROMOTION
  SUPPLIER_EVENT
  COMMUNITY_EVENT
  PRODUCT_LAUNCH
  TRAINING
  WELLNESS_DAY
  OTHER
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FUNDING_PENDING
  FUNDED
  PREPARATION
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FundingStatus {
  NOT_REQUESTED
  REQUESTED
  PARTIALLY_FUNDED
  FUNDED
  OVER_BUDGET
  CLOSED
}

enum EventChecklistStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  NOT_REQUIRED
}

enum EventExpenseStatus {
  PLANNED
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model Branch {
  id                 String         @id @default(cuid())
  name               String         @unique
  area               String
  managerName        String?
  revenueTarget      Decimal        @default(0) @db.Decimal(12, 2)
  staffResponseScore Int            @default(90)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  staffMembers       StaffMember[]
  patients           Patient[]
  refillEvents       RefillEvent[]
  followUpTasks      FollowUpTask[]
  orders             Order[]
  stockItems         StockItem[]
  operationalActions OperationalAction[]
  notifications      Notification[]
  events             Event[]
  communications     Communication[]
  operatingUnits     OperatingUnit[]
  fulfillmentOrders  Order[]        @relation("OrderFulfillmentBranch")
}

model StaffMember {
  id            String         @id @default(cuid())
  name          String
  role          String
  phone         String
  email         String?
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patients      Patient[]      @relation("AssignedPatients")
  followUpTasks FollowUpTask[]
  orders        Order[]
  refillEvents  RefillEvent[]
  operationalActions OperationalAction[]
  notifications Notification[]
  ownedEvents    Event[]              @relation("EventOwner")
  eventChecklistItems EventChecklistItem[]
  communications Communication[]
  appUser       AppUser?
  managedUnits  OperatingUnit[] @relation("OperatingUnitManager")
}

model Patient {
  id                String              @id @default(cuid())
  name              String
  phone             String
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  conditionCategory String
  packageType       PackageType
  medicationCycle   String
  nextRefillDate    DateTime
  status            PatientStatus
  assignedStaffId   String?
  assignedStaff     StaffMember?        @relation("AssignedPatients", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastContactedAt   DateTime?
  riskScore         RiskScore
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  medications       PatientMedication[]
  refillEvents      RefillEvent[]
  followUpTasks     FollowUpTask[]
  orders            Order[]
  communications     Communication[]
}

model PatientMedication {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dosage    String
  frequency String
  category  String
  notes     String?
  createdAt DateTime @default(now())
}

model RefillEvent {
  id          String       @id @default(cuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  handledById String?
  handledBy   StaffMember? @relation(fields: [handledById], references: [id], onDelete: SetNull)
  refillDate  DateTime
  status      String
  amount      Decimal      @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime     @default(now())
}

model FollowUpTask {
  id               String         @id @default(cuid())
  patientId        String?
  patient          Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  customerName     String
  type             FollowUpType
  status           FollowUpStatus @default(PENDING)
  reason           String
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  suggestedAction  String
  suggestedMessage String
  assignedStaffId  String?
  assignedStaff    StaffMember?   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  snoozedUntil     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  outcomeType      FollowUpOutcomeType?
  outcomeNotes     String?
  valueAmount      Decimal        @default(0) @db.Decimal(12, 2)
  lastContactedAt  DateTime?
  activities       FollowUpTaskActivity[]
  communications   Communication[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model FollowUpTaskActivity {
  id             String       @id @default(cuid())
  followUpTaskId String
  followUpTask   FollowUpTask @relation(fields: [followUpTaskId], references: [id], onDelete: Cascade)
  activityType   String
  description    String
  actorName      String?
  createdAt      DateTime     @default(now())

  @@index([followUpTaskId, createdAt])
}

model Order {
  id                    String       @id @default(cuid())
  customerName          String
  phone                 String
  source                OrderSource
  branchId              String
  branch                Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fulfillmentBranchId   String?
  fulfillmentBranch     Branch?      @relation("OrderFulfillmentBranch", fields: [fulfillmentBranchId], references: [id], onDelete: SetNull)
  originatingOperatingUnitId String?
  originatingOperatingUnit   OperatingUnit? @relation("OrderOriginUnit", fields: [originatingOperatingUnitId], references: [id], onDelete: SetNull)
  assignedOperatingUnitId    String?
  assignedOperatingUnit      OperatingUnit? @relation("OrderAssignedUnit", fields: [assignedOperatingUnitId], references: [id], onDelete: SetNull)
  type                  OrderType
  status                OrderStatus
  amount                Decimal      @default(0) @db.Decimal(12, 2)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  assignedStaffId       String?
  assignedStaff         StaffMember? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  patientId             String?
  patient               Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  paymentStatus         String
  fulfillmentPreference String
  internalNotes         String?
  items                 OrderItem[]
  communications         Communication[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  category    String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
}

model StockItem {
  id              String      @id @default(cuid())
  productName     String
  category        String
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockLevel      Int
  reorderLevel    Int
  status          StockStatus
  expiryDate      DateTime?
  suggestedAction String
  valueAtRisk     Decimal     @default(0) @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Report {
  id              String     @id @default(cuid())
  type            ReportType
  title           String
  description     String
  lastGeneratedAt DateTime
  keyMetric       String
  createdAt       DateTime   @default(now())
}

model PilotRequest {
  id             String             @id @default(cuid())
  pharmacyName   String
  contactName    String
  whatsappNumber String
  email          String?
  branchCount    Int
  currentSystem  String
  mainPain       String
  urgency        String
  notes          String?
  internalNotes  String?
  nextAction     String?
  contactedAt    DateTime?
  qualifiedAt    DateTime?
  closedAt       DateTime?
  status         PilotRequestStatus @default(NEW)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model ImportBatch {
  id                     String            @id @default(cuid())
  templateType           String
  fileName               String
  rowCount               Int
  readinessScore         Int
  validationStatus       String
  missingFields          String[]
  extraFields            String[]
  optionalFieldsDetected String[]
  issueCount             Int
  dateWarningCount       Int
  numericWarningCount    Int
  duplicateWarningCount  Int
  branchWarningCount     Int
  status                 ImportBatchStatus @default(DRAFT)
  notes                  String?
  rows                   Json?
  previewRows            Json?
  rowIssues              Json?
  approvedAt             DateTime?
  importedAt             DateTime?
  importResult           Json?
  importedRecordCount    Int?
  skippedRecordCount     Int?
  failedRecordCount      Int?
  executionNotes         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([templateType])
  @@index([validationStatus])
}

model OperationalAction {
  id              String                     @id @default(cuid())
  title           String
  description     String
  category        OperationalActionCategory
  priority        OperationalActionPriority  @default(MEDIUM)
  status          OperationalActionStatus    @default(OPEN)
  sourceType      String
  sourceId        String?
  branchId        String?
  branch          Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   StaffMember?               @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  completedAt     DateTime?
  outcomeType     OperationalActionOutcome?
  outcomeNotes    String?
  valueAmount     Decimal                    @default(0) @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  activities      OperationalActionActivity[]
  notifications   Notification[]
  eventChecklistItem EventChecklistItem?
  communications  Communication[]

  @@index([status, dueDate])
  @@index([priority, status])
  @@index([category])
  @@index([branchId])
  @@index([assignedStaffId])
}

model Notification {
  id                 String                      @id @default(cuid())
  type               NotificationType
  severity           NotificationSeverity        @default(INFO)
  status             NotificationStatus          @default(UNREAD)
  title              String
  message            String
  recipientType      NotificationRecipientType   @default(GENERAL)
  recipientStaffId   String?
  recipientStaff     StaffMember?                @relation(fields: [recipientStaffId], references: [id], onDelete: SetNull)
  recipientRole      String?
  branchId           String?
  branch             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sourceType         String?
  sourceId           String?
  actionId           String?
  action             OperationalAction?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  scheduledFor       DateTime?
  triggeredAt        DateTime?
  readAt             DateTime?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  deliveryChannel    NotificationDeliveryChannel @default(IN_APP)
  deliveryStatus     NotificationDeliveryStatus  @default(NOT_REQUIRED)
  metadata           Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  communications      Communication[]

  @@index([status, severity])
  @@index([type, actionId, status])
  @@index([branchId])
  @@index([recipientStaffId])
  @@index([createdAt])
}

model OperationalActionActivity {
  id           String            @id @default(cuid())
  actionId     String
  action       OperationalAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  activityType String
  description  String
  actorName    String?
  createdAt    DateTime          @default(now())

  @@index([actionId, createdAt])
}

model Event {
  id                 String        @id @default(cuid())
  title              String
  description        String
  eventType          EventType
  status             EventStatus   @default(DRAFT)
  priority           EventPriority @default(MEDIUM)
  companyName        String?
  venueName          String?
  location           String?
  branchId           String?
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  ownerStaffId       String?
  ownerStaff         StaffMember?  @relation("EventOwner", fields: [ownerStaffId], references: [id], onDelete: SetNull)
  startDate          DateTime
  endDate            DateTime
  expectedAttendance Int?
  actualAttendance   Int?
  objective          String
  expectedOutcome    String?
  proposedBudget     Decimal?      @db.Decimal(12, 2)
  approvedBudget     Decimal?      @db.Decimal(12, 2)
  fundsReleased      Decimal?      @db.Decimal(12, 2)
  actualSpend        Decimal?      @db.Decimal(12, 2)
  revenueGenerated   Decimal?      @db.Decimal(12, 2)
  leadsGenerated     Int?
  patientsRegistered Int?
  fundingStatus      FundingStatus @default(NOT_REQUESTED)
  approvalNotes      String?
  rejectionReason    String?
  approvedAt         DateTime?
  approvedBy         String?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  checklistItems     EventChecklistItem[]
  expenses           EventExpense[]
  activities         EventActivity[]
  review             EventReview?
  communications     Communication[]
  communicationOperatingUnitId String?
  communicationOperatingUnit   OperatingUnit? @relation(fields: [communicationOperatingUnitId], references: [id], onDelete: SetNull)

  @@index([status, startDate])
  @@index([eventType])
  @@index([branchId])
  @@index([ownerStaffId])
  @@index([fundingStatus])
}

model EventChecklistItem {
  id              String               @id @default(cuid())
  eventId         String
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String
  title           String
  description     String?
  assignedStaffId String?
  assignedStaff   StaffMember?         @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  operationalActionId String?          @unique
  operationalAction   OperationalAction? @relation(fields: [operationalActionId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  status          EventChecklistStatus @default(PENDING)
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([eventId, status])
  @@index([assignedStaffId])
  @@index([operationalActionId])
}

model EventExpense {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category         String
  description      String
  supplier         String?
  amount           Decimal            @db.Decimal(12, 2)
  status           EventExpenseStatus @default(PLANNED)
  paymentReference String?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([eventId, status])
}

model EventActivity {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activityType String
  description  String
  actorName    String?
  createdAt    DateTime @default(now())

  @@index([eventId, createdAt])
}

model EventReview {
  id                      String   @id @default(cuid())
  eventId                 String   @unique
  event                   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendance              Int
  leadsGenerated          Int
  revenueGenerated        Decimal  @default(0) @db.Decimal(12, 2)
  patientsRegistered      Int
  whatWorked              String
  whatFailed              String
  lessonsLearned          String
  nextTimeRecommendations String
  mediaLinks              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Communication {
  id                  String                         @id @default(cuid())
  channel             CommunicationChannel           @default(WHATSAPP)
  status              CommunicationStatus            @default(DRAFT)
  direction           CommunicationDirection         @default(OUTBOUND)
  recipientName       String
  recipientPhone      String?
  recipientType       CommunicationRecipientType     @default(OTHER)
  message             String
  subject             String?
  sourceType          String
  sourceId            String?
  patientId           String?
  patient             Patient?                       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  orderId             String?
  order               Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  followUpTaskId      String?
  followUpTask        FollowUpTask?                  @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)
  operationalActionId String?
  operationalAction   OperationalAction?             @relation(fields: [operationalActionId], references: [id], onDelete: SetNull)
  notificationId      String?
  notification        Notification?                  @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  eventId             String?
  event               Event?                         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedStaffId     String?
  assignedStaff       StaffMember?                   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  branchId            String?
  branch              Branch?                        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sendingOperatingUnitId String?
  sendingOperatingUnit   OperatingUnit?              @relation(fields: [sendingOperatingUnitId], references: [id], onDelete: SetNull)
  sendingWhatsappNumber  String?
  sendingContactLabel    String?
  scheduledFor        DateTime?
  openedAt            DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  respondedAt         DateTime?
  completedAt         DateTime?
  responseText        String?
  outcomeType         CommunicationOutcomeType?
  outcomeNotes        String?
  followUpRequired    Boolean                        @default(false)
  followUpDate        DateTime?
  externalReference   String?
  metadata            Json?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  activities          CommunicationActivity[]

  @@index([status, createdAt])
  @@index([channel, status])
  @@index([sourceType, sourceId])
  @@index([patientId])
  @@index([orderId])
  @@index([followUpTaskId])
  @@index([operationalActionId])
  @@index([notificationId])
  @@index([eventId])
  @@index([assignedStaffId])
  @@index([branchId])
  @@index([sendingOperatingUnitId])
}

model CommunicationActivity {
  id              String        @id @default(cuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  activityType    String
  description     String
  actorName       String?
  createdAt       DateTime      @default(now())

  @@index([communicationId, createdAt])
}

model OperatingUnit {
  id                       String                    @id @default(cuid())
  name                     String
  code                     String                    @unique
  type                     OperatingUnitType
  status                   OperatingUnitStatus       @default(ACTIVE)
  branchId                 String?
  branch                   Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentUnitId             String?
  parentUnit               OperatingUnit?            @relation("OperatingUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits               OperatingUnit[]           @relation("OperatingUnitHierarchy")
  location                 String?
  phone                    String?
  whatsappNumber           String?
  email                    String?
  contactLabel             String?
  managerStaffId           String?
  managerStaff             StaffMember?              @relation("OperatingUnitManager", fields: [managerStaffId], references: [id], onDelete: SetNull)
  handlesOnlineOrders      Boolean                   @default(false)
  handlesPatientFollowUps  Boolean                   @default(false)
  handlesStock             Boolean                   @default(false)
  handlesEvents            Boolean                   @default(false)
  handlesCommunications    Boolean                   @default(false)
  isPrimaryOnlineUnit      Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  userAccess               UserOperatingUnitAccess[]
  primaryUsers             AppUser[]                 @relation("PrimaryOperatingUnit")
  originatingOrders        Order[]                   @relation("OrderOriginUnit")
  assignedOrders           Order[]                   @relation("OrderAssignedUnit")
  communications           Communication[]
  events                   Event[]

  @@index([type, status])
  @@index([branchId])
  @@index([managerStaffId])
}

model AppUser {
  id                     String                    @id @default(cuid())
  name                   String
  email                  String                    @unique
  passwordHash           String
  status                 UserStatus                @default(INVITED)
  role                   UserRole
  staffMemberId          String?                   @unique
  staffMember            StaffMember?              @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  primaryOperatingUnitId String?
  primaryOperatingUnit   OperatingUnit?            @relation("PrimaryOperatingUnit", fields: [primaryOperatingUnitId], references: [id], onDelete: SetNull)
  lastLoginAt            DateTime?
  failedLoginCount       Int                       @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  unitAccess             UserOperatingUnitAccess[]
  sessions               AppSession[]

  @@index([status, role])
}

model UserOperatingUnitAccess {
  id              String                   @id @default(cuid())
  userId          String
  user            AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingUnitId String
  operatingUnit   OperatingUnit            @relation(fields: [operatingUnitId], references: [id], onDelete: Cascade)
  accessLevel     OperatingUnitAccessLevel @default(VIEW)
  isPrimary       Boolean                  @default(false)
  createdAt       DateTime                 @default(now())

  @@unique([userId, operatingUnitId])
  @@index([operatingUnitId])
}

model AppSession {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}
