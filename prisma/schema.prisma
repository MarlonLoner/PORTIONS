generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  LOST
  VIP
}

enum RiskScore {
  LOW
  MEDIUM
  HIGH
}

enum PackageType {
  STANDARD
  PREMIUM
  FAMILY_PACK
  CORPORATE
  CHRONIC_PLUS
}

enum FollowUpType {
  DUE_TODAY
  OVERDUE
  PRESCRIPTION_RENEWAL_NEEDED
  PAYMENT_PENDING
  DELIVERY_CONFIRMATION
  LOST_PATIENT_REVIVAL
}

enum FollowUpStatus {
  PENDING
  DONE
  SNOOZED
}

enum OrderSource {
  WHATSAPP
  WEBSITE
  APP
  WALK_IN
  DIASPORA
}

enum OrderStatus {
  NEW
  PHARMACIST_REVIEW
  QUOTED
  AWAITING_PAYMENT
  PAID
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderType {
  PRESCRIPTION
  REFILL
  OTC
  FAMILY_PACK
}

enum StockStatus {
  HEALTHY
  LOW_STOCK
  OVERSTOCK
  NEAR_EXPIRY
  DEAD_STOCK
}

enum ReportType {
  DAILY_EXECUTIVE
  WEEKLY_BRANCH
  CHRONIC_RETENTION
  ONLINE_SALES
  STOCK_RISK
  STAFF_FOLLOW_UP
}

enum PilotRequestStatus {
  NEW
  REVIEWED
  CONTACTED
  QUALIFIED
  CLOSED
}

enum ImportBatchStatus {
  DRAFT
  NEEDS_CLEANUP
  READY
  APPROVED
  IMPORTED
}

enum OperationalActionCategory {
  CHRONIC_PATIENT
  ORDER_RECOVERY
  STOCK_INTERVENTION
  BRANCH_ISSUE
  PILOT_TASK
  MANAGEMENT_DECISION
  GENERAL
}

enum OperationalActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperationalActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum OperationalActionOutcome {
  REVENUE_RECOVERED
  REVENUE_PROTECTED
  PATIENT_CONTACTED
  ORDER_RESOLVED
  STOCK_RESOLVED
  BRANCH_ESCALATED
  NO_RESPONSE
  NO_VALUE
  OTHER
}

enum NotificationType {
  ACTION_DUE
  ACTION_OVERDUE
  ACTION_BLOCKED
  ACTION_UNASSIGNED
  CRITICAL_ACTION
  ORDER_PAYMENT_RISK
  CHRONIC_REFILL_RISK
  STOCK_RISK
  BRANCH_ESCALATION
  PILOT_REVIEW
  MANAGEMENT_ALERT
  GENERAL
}

enum NotificationSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum NotificationRecipientType {
  STAFF
  BRANCH_MANAGER
  MANAGEMENT
  OWNER
  ROLE
  GENERAL
}

enum NotificationDeliveryChannel {
  IN_APP
  EMAIL_READY
  WHATSAPP_READY
  SMS_READY
}

enum NotificationDeliveryStatus {
  NOT_REQUIRED
  PENDING
  READY
  SENT
  FAILED
}

model Branch {
  id                 String         @id @default(cuid())
  name               String         @unique
  area               String
  managerName        String?
  revenueTarget      Decimal        @default(0) @db.Decimal(12, 2)
  staffResponseScore Int            @default(90)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  staffMembers       StaffMember[]
  patients           Patient[]
  refillEvents       RefillEvent[]
  followUpTasks      FollowUpTask[]
  orders             Order[]
  stockItems         StockItem[]
  operationalActions OperationalAction[]
  notifications      Notification[]
}

model StaffMember {
  id            String         @id @default(cuid())
  name          String
  role          String
  phone         String
  email         String?
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patients      Patient[]      @relation("AssignedPatients")
  followUpTasks FollowUpTask[]
  orders        Order[]
  refillEvents  RefillEvent[]
  operationalActions OperationalAction[]
  notifications Notification[]
}

model Patient {
  id                String              @id @default(cuid())
  name              String
  phone             String
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  conditionCategory String
  packageType       PackageType
  medicationCycle   String
  nextRefillDate    DateTime
  status            PatientStatus
  assignedStaffId   String?
  assignedStaff     StaffMember?        @relation("AssignedPatients", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastContactedAt   DateTime?
  riskScore         RiskScore
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  medications       PatientMedication[]
  refillEvents      RefillEvent[]
  followUpTasks     FollowUpTask[]
  orders            Order[]
}

model PatientMedication {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dosage    String
  frequency String
  category  String
  notes     String?
  createdAt DateTime @default(now())
}

model RefillEvent {
  id          String       @id @default(cuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  handledById String?
  handledBy   StaffMember? @relation(fields: [handledById], references: [id], onDelete: SetNull)
  refillDate  DateTime
  status      String
  amount      Decimal      @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime     @default(now())
}

model FollowUpTask {
  id               String         @id @default(cuid())
  patientId        String?
  patient          Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  customerName     String
  type             FollowUpType
  status           FollowUpStatus @default(PENDING)
  reason           String
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  suggestedAction  String
  suggestedMessage String
  assignedStaffId  String?
  assignedStaff    StaffMember?   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Order {
  id                    String       @id @default(cuid())
  customerName          String
  phone                 String
  source                OrderSource
  branchId              String
  branch                Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type                  OrderType
  status                OrderStatus
  amount                Decimal      @default(0) @db.Decimal(12, 2)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  assignedStaffId       String?
  assignedStaff         StaffMember? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  patientId             String?
  patient               Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  paymentStatus         String
  fulfillmentPreference String
  internalNotes         String?
  items                 OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  category    String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
}

model StockItem {
  id              String      @id @default(cuid())
  productName     String
  category        String
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockLevel      Int
  reorderLevel    Int
  status          StockStatus
  expiryDate      DateTime?
  suggestedAction String
  valueAtRisk     Decimal     @default(0) @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Report {
  id              String     @id @default(cuid())
  type            ReportType
  title           String
  description     String
  lastGeneratedAt DateTime
  keyMetric       String
  createdAt       DateTime   @default(now())
}

model PilotRequest {
  id             String             @id @default(cuid())
  pharmacyName   String
  contactName    String
  whatsappNumber String
  email          String?
  branchCount    Int
  currentSystem  String
  mainPain       String
  urgency        String
  notes          String?
  internalNotes  String?
  nextAction     String?
  contactedAt    DateTime?
  qualifiedAt    DateTime?
  closedAt       DateTime?
  status         PilotRequestStatus @default(NEW)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model ImportBatch {
  id                     String            @id @default(cuid())
  templateType           String
  fileName               String
  rowCount               Int
  readinessScore         Int
  validationStatus       String
  missingFields          String[]
  extraFields            String[]
  optionalFieldsDetected String[]
  issueCount             Int
  dateWarningCount       Int
  numericWarningCount    Int
  duplicateWarningCount  Int
  branchWarningCount     Int
  status                 ImportBatchStatus @default(DRAFT)
  notes                  String?
  rows                   Json?
  previewRows            Json?
  rowIssues              Json?
  approvedAt             DateTime?
  importedAt             DateTime?
  importResult           Json?
  importedRecordCount    Int?
  skippedRecordCount     Int?
  failedRecordCount      Int?
  executionNotes         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([templateType])
  @@index([validationStatus])
}

model OperationalAction {
  id              String                     @id @default(cuid())
  title           String
  description     String
  category        OperationalActionCategory
  priority        OperationalActionPriority  @default(MEDIUM)
  status          OperationalActionStatus    @default(OPEN)
  sourceType      String
  sourceId        String?
  branchId        String?
  branch          Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   StaffMember?               @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  completedAt     DateTime?
  outcomeType     OperationalActionOutcome?
  outcomeNotes    String?
  valueAmount     Decimal                    @default(0) @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  activities      OperationalActionActivity[]
  notifications   Notification[]

  @@index([status, dueDate])
  @@index([priority, status])
  @@index([category])
  @@index([branchId])
  @@index([assignedStaffId])
}

model Notification {
  id                 String                      @id @default(cuid())
  type               NotificationType
  severity           NotificationSeverity        @default(INFO)
  status             NotificationStatus          @default(UNREAD)
  title              String
  message            String
  recipientType      NotificationRecipientType   @default(GENERAL)
  recipientStaffId   String?
  recipientStaff     StaffMember?                @relation(fields: [recipientStaffId], references: [id], onDelete: SetNull)
  recipientRole      String?
  branchId           String?
  branch             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sourceType         String?
  sourceId           String?
  actionId           String?
  action             OperationalAction?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  scheduledFor       DateTime?
  triggeredAt        DateTime?
  readAt             DateTime?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  deliveryChannel    NotificationDeliveryChannel @default(IN_APP)
  deliveryStatus     NotificationDeliveryStatus  @default(NOT_REQUIRED)
  metadata           Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([status, severity])
  @@index([type, actionId, status])
  @@index([branchId])
  @@index([recipientStaffId])
  @@index([createdAt])
}

model OperationalActionActivity {
  id           String            @id @default(cuid())
  actionId     String
  action       OperationalAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  activityType String
  description  String
  actorName    String?
  createdAt    DateTime          @default(now())

  @@index([actionId, createdAt])
}
